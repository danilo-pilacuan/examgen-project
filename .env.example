# ============================================================
# Exam Generator — environment variables (example)
#
# Copy to `.env` and adjust values. The development compose
# (docker/docker-compose.yml) injects the service variables;
# this file documents the ones each app uses.
# ============================================================

# ------------------------------------------------------------
# Database (postgres-db, used by exam-app and agents-backend)
# ------------------------------------------------------------
# In dev (no Docker): postgresql://exam_user:exam_password@localhost:5432/exam_generator_db
# In compose:          postgresql://exam_user:exam_password@postgres-db:5432/exam_generator_db
DATABASE_URL=postgresql://exam_user:exam_password@postgres-db:5432/exam_generator_db

# ------------------------------------------------------------
# LLM (USFQ gateway, OpenAI-compatible; requires API key)
# ------------------------------------------------------------
LLM_BASE_URL=https://ai.usfq.edu.ec/api/agents/llm/main/v1
LLM_MODEL=zai-org/GLM-5.3-Flash
# Required: Bearer key for the USFQ gateway (get it from the gateway admin).
# NOTE: the pydantic setting is `openai_api_key`, so the env var is
# OPENAI_API_KEY (not LLM_API_KEY).
OPENAI_API_KEY=sk-xxxx

# ------------------------------------------------------------
# LLM raw audit (llm_responses table)
# ------------------------------------------------------------
# Master switch: store prompt + raw answer of every LLM call.
LLM_CAPTURE_RAW=true
# Also store the full chain of thought (raw thinking) when the server
# returns it (vLLM + reasoning models).
LLM_CAPTURE_THINKING=false

# ------------------------------------------------------------
# Internal services (compose names; do not change in Docker)
# ------------------------------------------------------------
LATEX_COMPILER_URL=http://latex-compiler:8080/compile
EMBEDDING_URL=http://embedding-service:8081/v1/embeddings

# ------------------------------------------------------------
# OpenWebUI (legacy, "legacy" profile)
# ------------------------------------------------------------
OPENWEBUI_URL=http://open-webui:8080
OPENWEBUI_PUBLIC_URL=http://localhost:3001
OPENWEBUI_ADMIN_EMAIL=admin@localhost
OPENWEBUI_ADMIN_PASSWORD=admin

# ------------------------------------------------------------
# exam-app (API)
# ------------------------------------------------------------
# Allowed CORS origins (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Root directory of the subjects' material (mounted at /app/inputs).
MATERIAL_ROOT=/app/inputs
# JWT signing secret for professor authentication (multi-tenant).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# ------------------------------------------------------------
# Frontend (nginx container; the browser resolves these URLs)
# ------------------------------------------------------------
# Empty = same origin (the frontend nginx proxies /api, /ws, /output).
# If the frontend is served from another domain, set absolute URLs:
#   VITE_API_URL=https://api.my-domain.com
#   VITE_WS_URL=wss://api.my-domain.com/ws
VITE_API_URL=
VITE_WS_URL=

# ------------------------------------------------------------
# embedding-service
# ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
