# ============================================================
# Generador de Exámenes — variables de entorno (ejemplo)
#
# Copiar a `.env` y ajustar valores. El compose de desarrollo
# (docker/docker-compose.yml) inyecta las variables de servicio;
# este archivo documenta las que usa cada app.
# ============================================================

# ------------------------------------------------------------
# Base de datos (postgres-db, usada por exam-app y agents-backend)
# ------------------------------------------------------------
# En dev (sin Docker): postgresql://exam_user:exam_password@localhost:5432/exam_generator_db
# En compose:          postgresql://exam_user:exam_password@postgres-db:5432/exam_generator_db
DATABASE_URL=postgresql://exam_user:exam_password@postgres-db:5432/exam_generator_db

# ------------------------------------------------------------
# LLM (vLLM remoto u OpenAI-compatible)
# ------------------------------------------------------------
LLM_BASE_URL=http://172.28.230.10:12555/v1
LLM_MODEL=zai-org/GLM-5.3-Flash
# LLM_API_KEY= (si el proveedor requiere clave)

# ------------------------------------------------------------
# Servicios internos (nombres de compose; no cambiar en Docker)
# ------------------------------------------------------------
LATEX_COMPILER_URL=http://latex-compiler:8080/compile
EMBEDDING_URL=http://embedding-service:8081/v1/embeddings

# ------------------------------------------------------------
# OpenWebUI (legado, perfil "legacy")
# ------------------------------------------------------------
OPENWEBUI_URL=http://open-webui:8080
OPENWEBUI_PUBLIC_URL=http://localhost:3001
OPENWEBUI_ADMIN_EMAIL=admin@localhost
OPENWEBUI_ADMIN_PASSWORD=admin

# ------------------------------------------------------------
# exam-app (API)
# ------------------------------------------------------------
# Orígenes CORS permitidos (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Directorio raíz del material de las materias (montado en /app/inputs).
MATERIAL_ROOT=/app/inputs

# ------------------------------------------------------------
# Frontend (contenedor nginx; el navegador resuelve estas URLs)
# ------------------------------------------------------------
# Vacías = mismo origen (el nginx del frontend proxifica /api, /ws, /output).
# Si el frontend se sirve desde otro dominio, poner URLs absolutas:
#   VITE_API_URL=https://api.mi-dominio.com
#   VITE_WS_URL=wss://api.mi-dominio.com/ws
VITE_API_URL=
VITE_WS_URL=

# ------------------------------------------------------------
# embedding-service
# ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
